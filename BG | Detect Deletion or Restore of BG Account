CloudAppEvents
| where ActionType in ("Delete user.", "Hard delete user.", "Restore user.")
| where RawEventData has_any ("<USER1-OBJECT-ID", "USER2-OBJECT-ID")
| extend BreakGlassAccountId = case(
    RawEventData has "USER1-OBJECT-ID", "USER1-OBJECT-ID",
    RawEventData has "USER2-OBJECT-ID", "USER2-OBJECT-ID",
    "")
| project Timestamp, ReportId, ActionType,
          ActorObjectId = AccountObjectId, 
          ActorDisplayName = AccountDisplayName,
          AccountObjectId = BreakGlassAccountId,
          IPAddress, Application, RawEventData
